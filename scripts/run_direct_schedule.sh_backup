#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/tb4_paths.sh
source "${SCRIPT_DIR}/lib/tb4_paths.sh"

export AMENT_TRACE_SETUP_FILES="${AMENT_TRACE_SETUP_FILES-}"
export AMENT_PYTHON_EXECUTABLE="${AMENT_PYTHON_EXECUTABLE:-$(command -v python3)}"

env_script="${TB4_ENV_SCRIPT}"

restore_nounset=0
if [[ $- == *u* ]]; then
  restore_nounset=1
  set +u
fi

source /opt/ros/humble/setup.bash
source "${TB4_RMF_OFFICIAL_WS}/install/setup.bash"
source "${TB4_ADAPTER_WS}/install/setup.bash"

if [ ! -f "${env_script}" ]; then
  echo "[error] Robot environment script not found:" >&2
  echo "        ${env_script}" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "${env_script}"

if [[ ${restore_nounset} -eq 1 ]]; then
  set -u
fi

exec ros2 run rmf_traffic_ros2 rmf_traffic_schedule "$@"
